<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="AAAMrX Restaurant Header"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="coral/foundation/tabs"
                maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <leftContent
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Left Side (Location)"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <locationText
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldDescription="Text to display for location or store address."
                                fieldLabel="Location Text (Left)"
                                name="./locationText"
                                required="{Boolean}true"/>
                        </items>
                    </leftContent>
                    <middleContent
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Middle (Name)"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <siteName
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldDescription="The name to display next to the logo."
                                fieldLabel="Site Name"
                                name="./siteName"
                                required="{Boolean}true"/>
                        </items>
                    </middleContent>
                    <rightContent
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Right Side (Contact)"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <phoneNumber
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldDescription="The main contact phone number."
                                fieldLabel="Phone Number (Right)"
                                name="./phoneNumber"
                                required="{Boolean}true"/>
                        </items>
                    </rightContent>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
